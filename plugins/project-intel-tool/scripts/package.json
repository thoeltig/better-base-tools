{
    "name": "project-intel-mcp-server",
    "version": "1.4.4",
    "license": "MIT",
    "author": "Thore Höltig",
    "description": "Lightweight reconnaissance system that provides direction before exploration. Query for relevant files before reading them - avoid expensive blind exploration and context pollution.",
    "keywords": [
        "context",
        "knowledge",
        "scan",
        "project",
        "files",
        "llm"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/thoeltig/better-base-tools.git"
    },
    "bugs": {
        "url": "https://github.com/thoeltig/better-base-tools/issues"
    },
    "type": "module",
    "bin": {
        "project-intel-mcp-server": "dist/index.js"
    },
    "main": "dist/index.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "test": "node --import tsx/esm --test --test-reporter=./tests/helpers/reporter.js lib/*.test.ts",
        "test:watch": "node --import tsx/esm --test --watch --test-reporter=./tests/helpers/reporter.js lib/*.test.ts",
        "typecheck": "tsc --noEmit",
        "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.29.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@types/node": "25.0.1",
        "typescript": "5.9.3",
        "esbuild": "0.28.0",
        "tsx": "4.22.4"
    },
    "engines": {
        "node": ">=22"
    }
}