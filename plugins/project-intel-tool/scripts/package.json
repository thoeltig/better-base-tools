{
    "name": "project-intel-mcp-server",
    "version": "1.5.2",
    "license": "MIT",
    "author": "Thore Höltig",
    "description": "Lightweight reconnaissance system that provides direction before exploration. Query for relevant files before reading them - avoid expensive blind exploration and context pollution.",
    "keywords": [
        "context",
        "knowledge",
        "scan",
        "project",
        "files",
        "llm"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/thoeltig/better-base-tools.git"
    },
    "bugs": {
        "url": "https://github.com/thoeltig/better-base-tools/issues"
    },
    "type": "module",
    "bin": {
        "project-intel-mcp-server": "dist/index.js"
    },
    "main": "dist/index.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "test": "tsc -p tsconfig.tests.json && node --enable-source-maps --test --test-reporter=./tests/helpers/reporter.js \"dist-tests/lib/**/*.test.js\"",
        "test:watch": "tsc -p tsconfig.tests.json --watch & node --enable-source-maps --test --watch --test-reporter=./tests/helpers/reporter.js \"dist-tests/lib/**/*.test.js\"",
        "typecheck": "tsc --noEmit",
        "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.30.0",
        "zod": "4.5.4"
    },
    "devDependencies": {    
        "@types/node": "24.13.3",
        "typescript": "7.0.2"
    },
    "engines": {
        "node": ">=20"
    }
}