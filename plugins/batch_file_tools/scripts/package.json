{
  "name": "batch-tools-mcp-server",
  "version": "1.3.1",
  "license": "MIT",
  "author": "Thore Höltig",
  "description": "Batch-capable Read/Edit MCP server: fewer round-trips, explicit error hints.",
  "repository": {
    "type": "git",
    "url": "https://github.com/thoeltig/better-base-tools.git"
  },
  "bugs": {
    "url": "https://github.com/thoeltig/better-base-tools/issues"
  },
  "type": "module",
  "bin": {
    "batch-tools-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.tests.json && node --enable-source-maps --test --test-reporter=./tests/helpers/reporter.js \"dist-tests/tests/**/*.test.js\"",
    "test:watch": "tsc -p tsconfig.tests.json --watch & node --enable-source-maps --test --watch --test-reporter=./tests/helpers/reporter.js \"dist-tests/tests/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  },
  "devDependencies": {    
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
